generarReporteBtn.addEventListener("click", () => {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();

  const actividades = typeof obtenerActividadesFiltradasReporte === "function"
    ? obtenerActividadesFiltradasReporte()
    : obtenerActividades();

  const tecnicos = typeof obtenerTecnicos === "function" ? obtenerTecnicos() : [];
  const clientes = typeof obtenerClientes === "function" ? obtenerClientes() : [];

  const fechaGeneracion = new Date().toLocaleDateString("es-CO");

  let y = 20;

  doc.setFont("helvetica", "bold");
  doc.setFontSize(18);
  doc.text("SEGURIDAD ATEMPI", 105, y, { align: "center" });

  y += 8;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");
  doc.text("SEGURIDAD, CON SENTIDO HUMANO", 105, y, { align: "center" });

  y += 12;

  doc.setFontSize(15);
  doc.setFont("helvetica", "bold");
  doc.text("REPORTE DE ACTIVIDADES", 105, y, { align: "center" });

  y += 8;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");
  doc.text(`Fecha de generación: ${fechaGeneracion}`, 15, y);

  y += 10;

  doc.setFont("helvetica", "bold");
  doc.setFontSize(11);
  doc.text("DATOS DE TÉCNICOS", 15, y);

  y += 7;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");

  if (tecnicos.length === 0) {
    doc.text("No hay técnicos registrados.", 15, y);
    y += 6;
  } else {
    tecnicos.forEach((tecnico) => {
      if (y > 270) {
        doc.addPage();
        y = 20;
      }

      doc.text(`Nombre: ${tecnico.nombre || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Documento: ${tecnico.documento || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Teléfono: ${tecnico.telefono || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Correo: ${tecnico.correo || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Estado: ${tecnico.estado || "activo"}`, 15, y);
      y += 8;
    });
  }

  doc.setFont("helvetica", "bold");
  doc.setFontSize(11);
  doc.text("DATOS DE CLIENTES", 15, y);

  y += 7;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");

  if (clientes.length === 0) {
    doc.text("No hay clientes registrados.", 15, y);
    y += 6;
  } else {
    clientes.forEach((cliente) => {
      if (y > 270) {
        doc.addPage();
        y = 20;
      }

      doc.text(`Nombre: ${cliente.nombre || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Documento: ${cliente.documento || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Teléfono: ${cliente.telefono || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Correo: ${cliente.correo || "Sin información"}`, 15, y);
      y += 5;
      doc.text(`Estado: ${cliente.estado || "activo"}`, 15, y);
      y += 8;
    });
  }

  if (y > 255) {
    doc.addPage();
    y = 20;
  }

  doc.setFont("helvetica", "bold");
  doc.setFontSize(11);
  doc.text("DETALLE DE ACTIVIDADES", 15, y);

  y += 8;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");

  if (actividades.length === 0) {
    doc.text("No hay actividades para mostrar.", 15, y);
  } else {
    actividades.forEach((actividad, indice) => {
      if (y > 255) {
        doc.addPage();
        y = 20;
      }

      const tecnicosActividad = typeof obtenerTecnicosDeActividad === "function"
        ? obtenerTecnicosDeActividad(actividad).join(", ")
        : "Sin técnico";

      const datos = [
        `Actividad ${indice + 1}`,
        `Fecha: ${actividad.fecha || "Sin fecha"}`,
        `Hora: ${actividad.hora || "Sin hora"}`,
        `Actividad: ${actividad.texto || "Sin actividad"}`,
        `Técnico(s): ${tecnicosActividad || "Sin técnico"}`,
        `Cliente: ${actividad.cliente || "Sin cliente"}`,
        `Sede: ${actividad.sede || "Sin sede"}`,
        `Estado: ${(actividad.estado || "pendiente").replace("-", " ")}`,
        `Observaciones: ${actividad.observaciones || "Sin observaciones"}`
      ];

      datos.forEach((linea) => {
        const lineas = doc.splitTextToSize(linea, 180);

        if (y + lineas.length * 5 > 275) {
          doc.addPage();
          y = 20;
        }

        doc.text(lineas, 15, y);
        y += lineas.length * 5;
      });

      y += 4;
    });
  }

  const paginas = doc.internal.getNumberOfPages();

  for (let pagina = 1; pagina <= paginas; pagina++) {
    doc.setPage(pagina);
    doc.setFontSize(8);
    doc.setFont("helvetica", "normal");
    doc.text(
      `Seguridad Atempi - Reporte de actividades | Página ${pagina} de ${paginas}`,
      105,
      290,
      { align: "center" }
    );
  }

  doc.save(`reporte-actividades-${new Date().toISOString().slice(0, 10)}.pdf`);
});

