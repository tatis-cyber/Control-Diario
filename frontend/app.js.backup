guardarUsuarioBtn.addEventListener("click", () => {
  if (!obtenerPermisosActuales().administrarUsuarios) return;
  const nombre = usuarioNombreInput.value.trim();
  const correo = usuarioCorreoInput.value.trim().toLowerCase();
  const password = usuarioPasswordInput.value;
  if (!nombre || !correo || (!usuarioEnEdicion && password.length < 6)) {
    estadoUsuarios.textContent = "Completa nombre, correo y una contraseña de mínimo 6 caracteres.";
    return;
  }
  const usuarios = obtenerUsuarios();
  const clave = nombre.toLowerCase().replace(/\s+/g, "");
  const usuarioAnterior = usuarioEnEdicion ? usuarios[usuarioEnEdicion] : null;
  if (usuarioEnEdicion && usuarioEnEdicion !== clave) delete usuarios[usuarioEnEdicion];
  usuarios[clave] = {
    name: nombre,
    email: correo,
    role: normalizarRol(usuarioRolInput.value),
    status: usuarioEstadoInput.value,
    password: password || usuarioAnterior?.password || "usuario123"
  };
  guardarUsuarios(usuarios);
  usuarioEnEdicion = null;
  usuarioNombreInput.value = "";
  usuarioCorreoInput.value = "";
  usuarioPasswordInput.value = "";
  usuarioRolInput.value = "user";
  usuarioEstadoInput.value = "activo";
  guardarUsuarioBtn.textContent = "➕ Agregar usuario";
  estadoUsuarios.textContent = "Usuario guardado correctamente.";
  renderizarUsuarios();
});

