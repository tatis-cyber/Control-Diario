function actualizarOpcionesTecnicos() {
  opcionesTecnicos.innerHTML = "";
  listaTecnicos.querySelectorAll("li").forEach((tecnico) => {
    if ((tecnico.dataset.estado || "activo") !== "activo") return;

    const nombreTecnico = tecnico.dataset.nombre || "";
    const opcion = document.createElement("label");
    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.value = nombreTecnico;
    opcion.append(checkbox, document.createTextNode(` ${nombreTecnico}`));
    opcionesTecnicos.append(opcion);
  });
}

function crearTecnico(datosTecnico){
  const tecnico = typeof datosTecnico === "string"
    ? { nombre: datosTecnico, documento: "", telefono: "", correo: "", estado: "activo" }
    : { estado: "activo", ...datosTecnico };
  const nuevoTecnico = document.createElement("li");
  const nombre = document.createElement("span");
  nombre.className = "nombre-tecnico";
  nombre.textContent = tecnico.nombre;

  const datos = document.createElement("div");
  datos.className = "datos-tecnico";
  [
    `Documento: ${tecnico.documento || "Sin registrar"}`,
    `Tel: ${tecnico.telefono || "Sin registrar"}`,
    tecnico.correo || "Sin correo"
  ].forEach((dato) => {
    const datoTexto = document.createElement("span");
    datoTexto.textContent = dato;
    datos.append(datoTexto);
  });

  const estado = document.createElement("span");
  estado.className = `estado-tecnico ${tecnico.estado}`;
  estado.textContent = tecnico.estado === "activo" ? "Activo" : "Inactivo";

  nuevoTecnico.dataset.nombre = tecnico.nombre;
  nuevoTecnico.dataset.documento = tecnico.documento;
  nuevoTecnico.dataset.telefono = tecnico.telefono;
  nuevoTecnico.dataset.correo = tecnico.correo;
  nuevoTecnico.dataset.estado = tecnico.estado;

  const eliminarBtn = document.createElement("button");
  eliminarBtn.className = "eliminar-tecnico";
  eliminarBtn.type = "button";
  eliminarBtn.textContent = "🗑️ Eliminar";
  eliminarBtn.title = "Eliminar técnico";

  nuevoTecnico.append(nombre, datos, estado, eliminarBtn);
  listaTecnicos.append(nuevoTecnico);
  actualizarOpcionesTecnicos();

  eliminarBtn.addEventListener("click", () => {
    nuevoTecnico.remove();
    actualizarOpcionesTecnicos();
    guardarTecnicos();
  });
}
