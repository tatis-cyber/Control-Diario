const usuariosIniciales = {
  usuario: { name: "Usuario", password: "usuario123", email: "usuario@demo.com", role: "administrador", status: "activo" },
  administrador: { name: "Administrador", password: "usuario123", email: "admin@demo.com", role: "administrador", status: "activo" }
};

const permisosPorRol = {
  administrador: {
    etiqueta: "Administrador",
    modulos: ["dashboard", "actividades", "programacion", "tecnicos", "clientes", "sedes", "aliados", "notificaciones", "reportes", "historial", "usuarios", "configuracion"],
    administrarUsuarios: true,
    administrarCatalogos: true,
    administrarActividades: true,
    actualizarEstados: true,
    administrarProgramacion: true
  },
  supervisor: {
    etiqueta: "Supervisor",
    modulos: ["dashboard", "actividades", "programacion", "tecnicos", "notificaciones", "reportes", "historial"],
    administrarUsuarios: false,
    administrarCatalogos: false,
    administrarActividades: false,
    actualizarEstados: true,
    administrarProgramacion: false
  },
  tecnico: {
    etiqueta: "Técnico",
    modulos: ["dashboard", "actividades", "programacion", "notificaciones"],
    administrarUsuarios: false,
    administrarCatalogos: false,
    administrarActividades: false,
    actualizarEstados: false,
    administrarProgramacion: false
  }
};

function normalizarRol(rol) {
  if (rol === "admin") return "administrador";
  if (rol === "user") return "tecnico";
  return permisosPorRol[rol] ? rol : "tecnico";
}

function obtenerPermisosActuales() {
  const usuarioActual = obtenerUsuarioActual();
  const cuentaActual = usuarioActual ? obtenerUsuarios()[usuarioActual.username] : null;
  const rol = cuentaActual?.role || usuarioActual?.role;
  return permisosPorRol[normalizarRol(rol)] || permisosPorRol.tecnico;
}

function obtenerUsuarios() {
  try {
    const usuariosGuardados = JSON.parse(localStorage.getItem("controlDiarioUsuarios"));
    const usuarios = usuariosGuardados && typeof usuariosGuardados === "object"
      ? { ...usuariosIniciales, ...usuariosGuardados }
      : { ...usuariosIniciales };
    return Object.fromEntries(Object.entries(usuarios).map(([usuario, cuenta]) => {
      const rolAnterior = cuenta.role;
      const rol = rolAnterior === "user" && ["usuario", "administrador"].includes(usuario)
        ? "administrador"
        : normalizarRol(rolAnterior);
      return [usuario, { ...cuenta, role: rol, status: cuenta.status || "activo" }];
    }));
  } catch (error) {
    return { ...usuariosIniciales };
  }
}

function guardarUsuarios(usuarios) {
  localStorage.setItem("controlDiarioUsuarios", JSON.stringify(usuarios));
}

function obtenerUsuarioActual() {
  try {
    const usuario = JSON.parse(localStorage.getItem("controlDiarioUsuario"));
    return usuario && usuario.username ? usuario : null;
  } catch (error) {
    return null;
  }
}

function guardarUsuarioActual(usuario) {
  localStorage.setItem("controlDiarioUsuario", JSON.stringify(usuario));
}

function cerrarSesion() {
  localStorage.removeItem("controlDiarioUsuario");
  loginScreen.classList.remove("hidden");
  appLayout.classList.add("hidden");
  usernameInput.value = "";
  passwordInput.value = "";
  loginError.textContent = "";
  usernameInput.focus();
}

function mostrarAppSegunRol() {
  const usuarioActual = obtenerUsuarioActual();

  if (!usuarioActual) {
    cerrarSesion();
    return;
  }

  loginScreen.classList.add("hidden");
  appLayout.classList.remove("hidden");

  const cuentaActual = obtenerUsuarios()[usuarioActual.username];
  const rolActual = cuentaActual?.role || usuarioActual.role;
  const permisos = permisosPorRol[normalizarRol(rolActual)] || permisosPorRol.tecnico;
  guardarUsuarioActual({ ...usuarioActual, role: normalizarRol(rolActual) });
  const nombreBase = cuentaActual?.name || usuarioActual.username;
  const nombreMostrar = nombreBase.charAt(0).toUpperCase() + nombreBase.slice(1);
  document.getElementById("profileName").textContent = nombreMostrar;
  document.getElementById("profileAvatar").textContent = usuarioActual.username.charAt(0).toUpperCase();
  document.getElementById("profileRole").textContent = permisos.etiqueta;

  document.querySelectorAll(".menu-item").forEach((boton) => {
    const target = boton.dataset.target;
    if (!target) return;
    boton.style.display = permisos.modulos.includes(target) ? "block" : "none";
  });

  document.querySelectorAll(".module-panel").forEach((panel) => {
    const target = panel.dataset.modulePanel;
    panel.classList.toggle("active", target === "dashboard" && permisos.modulos.includes(target));
  });
  formularioActividad.classList.toggle("hidden", !permisos.administrarActividades);
  formularioProgramacion.classList.toggle("hidden", !permisos.administrarProgramacion && !programacionEnEdicion);
  guardarUsuarioBtn.disabled = !permisos.administrarUsuarios;
  aplicarPermisosControles();
}

function aplicarPermisosControles() {
  const permisos = obtenerPermisosActuales();
  lista.querySelectorAll(".estadoBtn").forEach((boton) => { boton.disabled = !permisos.actualizarEstados; });
  lista.querySelectorAll(".editar, .eliminar").forEach((boton) => { boton.style.display = permisos.administrarActividades ? "" : "none"; });
  listaProgramacion.querySelectorAll(".editar-programacion, .eliminar-programacion").forEach((boton) => {
    boton.style.display = permisos.administrarProgramacion ? "" : "none";
  });
}

loginForm.addEventListener("submit", (evento) => {
  evento.preventDefault();

  const usuario = usernameInput.value.trim().toLowerCase();
  const password = passwordInput.value.trim();
  const usuarios = obtenerUsuarios();
  const cuenta = usuarios[usuario] || usuarios[usuario === "admin" ? "administrador" : usuario];

  if (!cuenta || cuenta.password !== password || cuenta.status === "inactivo") {
    loginError.textContent = "Usuario o contraseña incorrectos. Prueba: usuario / usuario123";
    return;
  }

  const nombreUsuario = usuario === "admin" ? "administrador" : usuario;
  guardarUsuarioActual({ username: nombreUsuario, role: normalizarRol(cuenta.role) });
  loginError.textContent = "";
  mostrarAppSegunRol();
});

mostrarRegistroBtn.addEventListener("click", () => {
  const registroVisible = !registroForm.classList.contains("hidden");
  registroForm.classList.toggle("hidden", registroVisible);
  recuperacionForm.classList.add("hidden");
  loginForm.classList.toggle("hidden", !registroVisible);
  mostrarRecuperacionBtn.classList.remove("hidden");
  mostrarRegistroBtn.textContent = registroVisible ? "Crear una cuenta" : "Volver a ingresar";
  loginError.textContent = "";
  registroError.textContent = "";
  recuperacionError.textContent = "";
  if (!registroVisible) registroUsuarioInput.focus();
});


registroForm.addEventListener("submit", (evento) => {
  evento.preventDefault();

  const usuario = registroUsuarioInput.value.trim().toLowerCase();
  const correo = document.getElementById("registroCorreo").value.trim().toLowerCase();
  const password = registroPasswordInput.value;
  const confirmarPassword = confirmarPasswordInput.value;
  const usuarios = obtenerUsuarios();

  if (usuarios[usuario]) {
    registroError.textContent = "Ese usuario ya existe.";
    return;
  }

  if (Object.values(usuarios).some((cuenta) => cuenta.email === correo)) {
    registroError.textContent = "Ese correo ya está registrado.";
    return;
  }

  if (password !== confirmarPassword) {
    registroError.textContent = "Las contraseñas no coinciden.";
    return;
  }

  usuarios[usuario] = { name: usuario, password, email: correo, role: "tecnico", status: "activo" };
  guardarUsuarios(usuarios);
  registroForm.reset();
  registroForm.classList.add("hidden");
  loginForm.classList.remove("hidden");
  mostrarRegistroBtn.textContent = "Crear una cuenta";
  registroError.textContent = "";
  loginError.textContent = "Cuenta creada. Presiona Ingresar.";
  usernameInput.value = "";
  passwordInput.value = "";
  usernameInput.focus();
});

mostrarRecuperacionBtn.addEventListener("click", () => {
  loginForm.classList.add("hidden");
  registroForm.classList.add("hidden");
  recuperacionForm.classList.remove("hidden");
  mostrarRegistroBtn.classList.add("hidden");
  recuperacionError.textContent = "";
  recuperacionCorreoInput.focus();
});

volverLoginRecuperacionBtn.addEventListener("click", () => {
  recuperacionForm.classList.add("hidden");
  loginForm.classList.remove("hidden");
  mostrarRegistroBtn.classList.remove("hidden");
  mostrarRegistroBtn.textContent = "Crear una cuenta";
  recuperacionError.textContent = "";
  usernameInput.focus();
});

recuperacionForm.addEventListener("submit", (evento) => {
  evento.preventDefault();

  const correo = recuperacionCorreoInput.value.trim().toLowerCase();
  const nuevaPassword = nuevaPasswordInput.value;
  const confirmarNuevaPassword = confirmarNuevaPasswordInput.value;
  const usuarios = obtenerUsuarios();
  const usuarioEncontrado = Object.entries(usuarios).find(([, cuenta]) => cuenta.email === correo);

  if (!usuarioEncontrado) {
    recuperacionError.textContent = "No encontramos una cuenta con ese correo.";
    return;
  }

  if (nuevaPassword !== confirmarNuevaPassword) {
    recuperacionError.textContent = "Las contraseñas no coinciden.";
    return;
  }

  const [usuario] = usuarioEncontrado;
  usuarios[usuario].password = nuevaPassword;
  guardarUsuarios(usuarios);
  recuperacionForm.reset();
  recuperacionForm.classList.add("hidden");
  loginForm.classList.remove("hidden");
  mostrarRegistroBtn.classList.remove("hidden");
  mostrarRegistroBtn.textContent = "Crear una cuenta";
  usernameInput.value = "";
  passwordInput.value = "";
  loginError.textContent = "Contraseña actualizada. Ya puedes ingresar.";
  usernameInput.focus();
});

logoutBtn.addEventListener("click", cerrarSesion);

