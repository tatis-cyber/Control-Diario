let notificacionesRecordatorio = new Set();

function reproducirSonidoNotificacion() {
  try {
    const contexto = new (window.AudioContext || window.webkitAudioContext)();
    const oscilador = contexto.createOscillator();
    const ganancia = contexto.createGain();

    oscilador.type = "sine";
    oscilador.frequency.setValueAtTime(880, contexto.currentTime);
    oscilador.frequency.setValueAtTime(660, contexto.currentTime + 0.15);

    ganancia.gain.setValueAtTime(0.25, contexto.currentTime);
    ganancia.gain.exponentialRampToValueAtTime(
      0.001,
      contexto.currentTime + 0.5
    );

    oscilador.connect(ganancia);
    ganancia.connect(contexto.destination);

    oscilador.start();
    oscilador.stop(contexto.currentTime + 0.5);
  } catch (error) {
    console.log("No se pudo reproducir el sonido.");
  }
}

function mostrarRecordatorio(mensaje) {
  reproducirSonidoNotificacion();

  if ("Notification" in window && Notification.permission === "granted") {
    new Notification("🔔 Control Diario", {
      body: mensaje
    });
  }

  alert(`🔔 ${mensaje}`);

  if (typeof renderizarNotificaciones === "function") {
    renderizarNotificaciones();
  }
}

function revisarRecordatorios() {
  const ahora = new Date();

  const actividades = typeof obtenerActividades === "function"
    ? obtenerActividades()
    : [];

  const programaciones = typeof obtenerProgramaciones === "function"
    ? obtenerProgramaciones()
    : [];

  actividades.forEach((actividad) => {
    if (!actividad.fecha || !actividad.hora) return;
    if (actividad.estado === "terminada") return;

    const fechaHora = new Date(`${actividad.fecha}T${actividad.hora}`);
    const diferencia = fechaHora.getTime() - ahora.getTime();

    
    if (diferencia <= 10 * 60 * 1000 && diferencia > -60 * 1000) {
      const id = `actividad-${actividad.id || actividad.texto}-${actividad.fecha}-${actividad.hora}`;

      if (!notificacionesRecordatorio.has(id)) {
        notificacionesRecordatorio.add(id);

        mostrarRecordatorio(
          `La actividad "${actividad.texto || "Sin nombre"}" está próxima.`
        );
      }
    }
  });

  programaciones.forEach((programacion) => {
    if (!programacion.fecha || !programacion.hora) return;

    const fechaHora = new Date(`${programacion.fecha}T${programacion.hora}`);
    const diferencia = fechaHora.getTime() - ahora.getTime();

    if (diferencia <= 10 * 60 * 1000 && diferencia > -60 * 1000) {
      const id = `programacion-${programacion.id || programacion.actividad}-${programacion.fecha}-${programacion.hora}`;

      if (!notificacionesRecordatorio.has(id)) {
        notificacionesRecordatorio.add(id);

        mostrarRecordatorio(
          `La programación "${programacion.actividad || "Sin nombre"}" está próxima.`
        );
      }
    }
  });
}


setInterval(revisarRecordatorios, 60 * 1000);


setTimeout(revisarRecordatorios, 2000);


if ("Notification" in window && Notification.permission === "default") {
  Notification.requestPermission();
}
cat >> app.js <<'EOF'


   //MEJORA DEL MODULO PROGRAMACIONES

  
function guardarProgramacionCompleta(programacion) {
  const programaciones = typeof obtenerProgramaciones === "function"
    ? obtenerProgramaciones()
    : [];

  const nuevaProgramacion = {
    id: programacion.id || Date.now(),
    actividad: programacion.actividad || programacion.texto || "",
    tecnico: programacion.tecnico || "",
    cliente: programacion.cliente || "",
    sede: programacion.sede || "",
    fecha: programacion.fecha || "",
    hora: programacion.hora || "",
    estado: programacion.estado || "programada",
    observaciones: programacion.observaciones || ""
  };

  programaciones.push(nuevaProgramacion);

  localStorage.setItem(
    "programaciones",
    JSON.stringify(programaciones)
  );

  if (typeof renderizarNotificaciones === "function") {
    renderizarNotificaciones();
  }

  return nuevaProgramacion;
}

function obtenerProgramacionesCompletas() {
  try {
    const programaciones = JSON.parse(
      localStorage.getItem("programaciones")
    );

    return Array.isArray(programaciones)
      ? programaciones
      : [];
  } catch (error) {
    return [];
  }
}

function eliminarProgramacion(id) {
  const programaciones = obtenerProgramacionesCompletas();

  const actualizadas = programaciones.filter(
    (programacion) => String(programacion.id) !== String(id)
  );

  localStorage.setItem(
    "programaciones",
    JSON.stringify(actualizadas)
  );

  if (typeof renderizarNotificaciones === "function") {
    renderizarNotificaciones();
  }
}

