function actualizarEstado() {
  const actividades = document.querySelectorAll("#lista li");
  let pendientes = 0;
  let enProceso = 0;
  let terminadas = 0;

  actividades.forEach((actividad) => {
    const estado = actividad.querySelector(".estado");

    if (estado.classList.contains("pendiente")) pendientes++;
    if (estado.classList.contains("procesando")) enProceso++;
    if (estado.classList.contains("terminada")) terminadas++;
  });

  document.getElementById("total").textContent = pendientes + enProceso + terminadas;
  document.getElementById("pendientes").textContent = pendientes;
  document.getElementById("en-proceso").textContent = enProceso;
  document.getElementById("terminadas").textContent = terminadas;

  const porcentaje = actividades.length ? Math.round((terminadas / actividades.length) * 100) : 0;
  document.getElementById("porcentajeCompletado").textContent = `${porcentaje}%`;
  document.getElementById("barraProgreso").style.width = `${porcentaje}%`;
  document.getElementById("badgePendientes").textContent = pendientes;
  document.getElementById("resumenProgreso").textContent = actividades.length
    ? `${terminadas} de ${actividades.length} actividad${actividades.length === 1 ? "" : "es"} completada${terminadas === 1 ? "" : "s"}.`
    : "Aún no hay actividades registradas.";

  const listaPendientes = document.getElementById("dashboardPendientes");
  listaPendientes.innerHTML = "";
  const pendientesVisibles = [...document.querySelectorAll("#lista li")]
    .filter((actividad) => actividad.querySelector(".estado")?.classList.contains("pendiente"))
    .slice(0, 5);

  if (!pendientesVisibles.length) {
    const vacio = document.createElement("li");
    vacio.className = "empty-pending";
    vacio.textContent = "No tienes pendientes por ahora.";
    listaPendientes.append(vacio);
    return;
  }

  pendientesVisibles.forEach((actividad) => {
    const pendiente = document.createElement("li");
    pendiente.textContent = actividad.querySelector(".texto-actividad")?.textContent || "Actividad pendiente";
    listaPendientes.append(pendiente);
  });
}

function formatearHora(hora) {
  if (!hora) return "";

  const [horas, minutos] = hora.split(":").map(Number);
  if (Number.isNaN(horas) || Number.isNaN(minutos)) return hora;

  const fechaHora = new Date(1970, 0, 1, horas, minutos);
  return fechaHora.toLocaleTimeString("es-CO", {
    hour: "numeric",
    minute: "2-digit",
    hour12: true
  });
}

function crearActividad(textoActividad, fechaActividad = "", horaActividad = "", estadoInicial = "pendiente", tecnicosIniciales = "", clienteactividadinicial = "", sedeActividadInicial = "", aliadoActividadInicial = "", observacionesIniciales = "") {
  const nuevaActividad = document.createElement("li");
  const texto = document.createElement("span");
  const estado = document.createElement("span");
  const estadoBtn = document.createElement("button");
  const editarBtn = document.createElement("button");
  const eliminarBtn = document.createElement("button");
  const detalles = document.createElement("div");
  const informacion = document.createElement("div");

  const fecha = document.createElement("span");
  const fechaTexto = document.createElement("span");
  const horaTexto = document.createElement("span");
  const tecnico = document.createElement("span");
  const observaciones = document.createElement("span");
  observaciones.className = "observaciones-actividad";
  observaciones.textContent = observacionesIniciales
    ? `📝 ${observacionesIniciales}`
    : "📝 Sin observaciones";
  const tecnicos = Array.isArray(tecnicosIniciales)
    ? tecnicosIniciales
    : String(tecnicosIniciales).replace(/^👤\s*/, "").split(",").map((nombre) => nombre.trim()).filter(Boolean);
  const cliente = document.createElement("span");
  const sede = document.createElement("span");
  const aliado = document.createElement("span");
  cliente.className = "cliente-actividad";
  cliente.textContent = clienteactividadinicial ? `Cliente: ${clienteactividadinicial}` : "Cliente: sin cliente";
  sede.className = "sede-actividad";
  sede.textContent = sedeActividadInicial ? `Sede: ${sedeActividadInicial}` : "Sede: sin sede";
  aliado.className = "aliado-actividad";
  aliado.textContent = aliadoActividadInicial ? `Aliado: ${aliadoActividadInicial}` : "Aliado: sin aliado";

  nuevaActividad.dataset.fecha = fechaActividad;
  nuevaActividad.dataset.hora = horaActividad;
  nuevaActividad.dataset.tecnicos = tecnicos.join(",");
  nuevaActividad.dataset.cliente = clienteactividadinicial;
  nuevaActividad.dataset.sede = sedeActividadInicial;
  nuevaActividad.dataset.aliado = aliadoActividadInicial;
  nuevaActividad.dataset.observaciones = observacionesIniciales;

  texto.className = "texto-actividad";
  texto.textContent = textoActividad;
  estado.className = `estado ${estadoInicial}`;
  estadoBtn.className = "estadoBtn";
  estadoBtn.type = "button";
  editarBtn.className = "editar";
  editarBtn.type = "button";
  editarBtn.textContent = "✏️ Editar";
  editarBtn.setAttribute("aria-label", "Editar actividad");
  editarBtn.title = "Editar actividad";
  eliminarBtn.className = "eliminar";
  eliminarBtn.type = "button";
  eliminarBtn.textContent = "🗑️ Eliminar";
  eliminarBtn.setAttribute("aria-label", "Eliminar actividad");
  eliminarBtn.title = "Eliminar actividad";
  tecnico.className = "tecnico-actividad";
  if (tecnicos.length) {
    tecnicos.forEach((nombre) => {
      const icono = document.createElement("span");
      icono.className = "icono-tecnico";
      icono.textContent = "👤";
      icono.title = nombre;
      tecnico.append(icono);
    });
    tecnico.append(document.createTextNode(` ${tecnicos.join(", ")}`));
  } else {
    tecnico.textContent = "👤 sin técnico";
  }

  detalles.className = "detalles-actividad";
  informacion.className = "informacion-actividad";
  informacion.append(fecha, tecnico, cliente, sede, aliado, observaciones);
  detalles.append(texto, informacion);
  nuevaActividad.append(detalles, estado, estadoBtn, editarBtn, eliminarBtn);
  lista.append(nuevaActividad);

  fecha.className = "fecha-actividad";
  fechaTexto.className = "fecha-texto";
  horaTexto.className = "hora-texto";
  const fechaSeleccionada = fechaActividad
    ? new Date(`${fechaActividad}T00:00:00`)
    : null;
  horaTexto.textContent = horaActividad ? `⏰ ${formatearHora(horaActividad)}` : "";

  if (fechaSeleccionada && !Number.isNaN(fechaSeleccionada.getTime())) {

    const fechaNueva = fechaSeleccionada.toLocaleDateString("es-CO", {
      weekday: "long",
      day: "numeric",
      month: "long"
    });

    fechaTexto.textContent = `📅 ${fechaNueva}`;
  } else if (fechaActividad) {
    fechaTexto.textContent = `📅 ${fechaActividad}`;
  } else {
    fechaTexto.textContent = "📅 sin fecha";
  }
  fecha.append(fechaTexto, horaTexto);


  let estadoActual = ["pendiente", "procesando", "terminada"].indexOf(estadoInicial);
  if (estadoActual < 0) estadoActual = 0;

  function actualizarBotones() {
    const textosEstado = ["🕐 Pendiente", "🔄 En proceso", "✅ Terminada"];
    const textosBoton = ["🔄 En proceso", "✅ Terminar", "↩️ Reabrir"];
    estado.textContent = textosEstado[estadoActual];
    estadoBtn.textContent = textosBoton[estadoActual];
    estadoBtn.setAttribute("aria-label", textosBoton[estadoActual]);
    estadoBtn.title = textosBoton[estadoActual];
    nuevaActividad.classList.toggle("completada", estadoActual === 2);
  }

  actualizarBotones();

  estadoBtn.addEventListener("click", () => {
    estadoActual = (estadoActual + 1) % 3;
    estado.className = `estado ${["pendiente", "procesando", "terminada"][estadoActual]}`;
    actualizarBotones();
    actualizarEstado();
    guardarActividades();
    aplicarFiltrosActividades();
  });

  editarBtn.addEventListener("click", (evento) => {
    evento.preventDefault();
    evento.stopPropagation();
    iniciarEdicion(nuevaActividad);
  });

  eliminarBtn.addEventListener("click", () => {
    if (actividadEnEdicion === nuevaActividad) cancelarEdicion();
    nuevaActividad.remove();
    actualizarEstado();
    guardarActividades();
    aplicarFiltrosActividades();
  });
}

function iniciarEdicion(actividad) {
  actividadEnEdicion = actividad;
  actividadInput.value = actividad.querySelector(".texto-actividad")?.textContent || "";
  fechaInput.value = actividad.dataset.fecha || "";
  horaInput.value = actividad.dataset.hora || "";
  estadoEdicionInput.value = actividad.querySelector(".estado")?.classList[1] || "pendiente";
  observacionesActividad.value = actividad.dataset.observaciones || "";
  clienteSeleccionado = actividad.dataset.cliente || "";
  sedeSeleccionada = actividad.dataset.sede || "";
  aliadoSeleccionado = actividad.dataset.aliado || "";
  abrirClientesBtn.textContent = clienteSeleccionado || "Selecciona un cliente";
  abrirSedesBtn.textContent = sedeSeleccionada || "Selecciona una sede";
  abrirAliadosBtn.textContent = aliadoSeleccionado || "Selecciona un aliado";

  const tecnicosSeleccionados = (actividad.dataset.tecnicos || "").split(",").filter(Boolean);
  opcionesTecnicos.querySelectorAll("input").forEach((opcion) => {
    opcion.checked = tecnicosSeleccionados.includes(opcion.value);
  });
  actualizarTextoSelector();
  agregarBtn.textContent = "💾 Guardar cambios";
  cancelarEdicionBtn.classList.remove("hidden");
  modoEdicionActividad.classList.remove("hidden");
  formularioActividad.classList.add("modal-edicion");
  overlayEdicion.classList.remove("hidden");
  overlayEdicion.setAttribute("aria-hidden", "false");
  actividadInput.focus();
  actividad.scrollIntoView({ behavior: "smooth", block: "center" });
}
function obtenerTecnicosDeActividad(actividad) {
  if (Array.isArray(actividad.tecnicos)) return actividad.tecnicos;
  if (actividad.tecnicos) return String(actividad.tecnicos).split(",").map((nombre) => nombre.trim());
  if (actividad.tecnico) return [actividad.tecnico];
  return [];
}

function tecnicoDisponible(tecnico, fecha, hora, actividadIgnorada = null) {
  if (!tecnico || !fecha || !hora) return true;

  const nuevaFechaHora = new Date(`${fecha}T${hora}`);
  if (Number.isNaN(nuevaFechaHora.getTime())) return true;

  return !obtenerActividades().some((actividad) => {
    if (actividadIgnorada
      && actividad.texto === actividadIgnorada.querySelector(".texto-actividad")?.textContent
      && actividad.fecha === actividadIgnorada.dataset.fecha
      && actividad.hora === actividadIgnorada.dataset.hora) return false;
    if (actividad.fecha !== fecha || !actividad.hora) return false;
    if (!obtenerTecnicosDeActividad(actividad).includes(tecnico)) return false;

    const actividadFechaHora = new Date(`${actividad.fecha}T${actividad.hora}`);
    const diferenciaHoras = Math.abs(nuevaFechaHora - actividadFechaHora) / (1000 * 60 * 60);
    return diferenciaHoras < 2;
  });
}

function agregarActividad() {

  const actividad = actividadInput.value.trim();
  const tecnicos = [...opcionesTecnicos.querySelectorAll("input:checked")]
    .map((opcion) => opcion.value);
  const cliente = clienteSeleccionado;
  const sede = sedeSeleccionada;
  const aliado = aliadoSeleccionado;
  const fecha = fechaInput.value;
  const hora = horaInput.value;
  const observaciones = observacionesActividad.value.trim();

  if (!actividad) {
    alert("Escribe una actividad primero.");
    actividadInput.focus();
    return;
  }

  if (!fecha || !hora) {
    alert("Selecciona la fecha y la hora de la actividad.");
    fechaInput.focus();
    return;
  }

  const tecnicosOcupados = tecnicos.filter((tecnico) => !tecnicoDisponible(tecnico, fecha, hora, actividadEnEdicion));
  if (tecnicosOcupados.length) {
    alert(`El técnico ${tecnicosOcupados.join(", ")} ya tiene una actividad en ese horario. Deben pasar mínimo 2 horas.`);
    return;
  }

  const estado = estadoEdicionInput.value || "pendiente";
  if (actividadEnEdicion) actividadEnEdicion.remove();
  enviarActividadAlBackend();
  crearActividad(actividad, fecha, hora, estado, tecnicos, cliente, sede, aliado, observaciones);
  cancelarEdicion();
  actividadInput.focus();
  actualizarEstado();
  guardarActividades();
  aplicarFiltrosActividades();
}


async function enviarActividadAlBackend() {
  try {
    const actividad = actividadInput.value.trim();
    const tecnicos = [...opcionesTecnicos.querySelectorAll("input:checked")]
      .map((opcion) => opcion.value);

    const datos = {
      actividad: actividad,
      tecnico: tecnicos.join(", "),
      sede: sedeSeleccionada || "",
      cliente: clienteSeleccionado || "",
      aliado: aliadoSeleccionado || "",
      fecha: fechaInput.value,
      hora: horaInput.value,
      estado: estadoEdicionInput.value || "pendiente",
      observaciones: observacionesActividad.value.trim()
    };

    const respuesta = await fetch(`${API_URL}/actividades`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify(datos)
    });

    if (!respuesta.ok) {
      console.error("Error al guardar actividad en Laravel:", await respuesta.text());
      return;
    }

    console.log("Actividad guardada en Laravel correctamente.");
  } catch (error) {
    console.error("Error de conexión con Laravel:", error);
  }
}

function actualizarTextoSelector() {
  const seleccionados = [...opcionesTecnicos.querySelectorAll("input:checked")];
  abrirTecnicosBtn.textContent = seleccionados.length
