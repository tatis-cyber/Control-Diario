  const correo = correoTecnicoInput.value.trim().toLowerCase();
  const estado = estadoTecnicoInput.value;

  if (!nombreTecnico || !documento || !telefono || !correo) {
    alert("Complete todos los datos del técnico.");
    tecnicoinput.focus();
    return;
  }
  const tecnicosRegistrados = obtenerTecnicos();
  if (tecnicosRegistrados.some((tecnico) => tecnico.documento === documento)) {
    alert("Ya existe un técnico con ese documento.");
    documentoTecnicoInput.focus();
    return;
  }
  if (tecnicosRegistrados.some((tecnico) => tecnico.correo?.toLowerCase() === correo)) {
    alert("Ya existe un técnico con ese correo.");
    correoTecnicoInput.focus();
    return;
  }
  crearTecnico({ nombre: nombreTecnico, documento, telefono, correo, estado });
  tecnicoinput.value = "";
  documentoTecnicoInput.value = "";
  telefonoTecnicoInput.value = "";
  correoTecnicoInput.value = "";
  estadoTecnicoInput.value = "activo";
  tecnicoinput.focus();
  const datosTecnicoBackend = {
    nombre: nombreTecnico,
    documento,
    telefono,
    correo,
    estado
  };

  guardarTecnicos();

  fetch(`${API_URL}/tecnicos`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    body: JSON.stringify(datosTecnicoBackend)
  }).then(async (respuesta) => {
    if (!respuesta.ok) {
      console.error("Error al guardar técnico en Laravel:", await respuesta.text());
    }
  }).catch((error) => {
    console.error("Error de conexión con Laravel:", error);
  });
});
