const clasesEstado = {
  pendientes: "pendiente",
  "en-proceso": "procesando",
  terminadas: "terminada"
};

function obtenerActividades() {
  try {
    const actividades = JSON.parse(localStorage.getItem("actividades"));
    return Array.isArray(actividades) ? actividades : [];
  } catch (error) {
    return [];
  }
}

function guardarActividades() {
  const actividades = [...lista.querySelectorAll("li")].map((actividad) => ({
    texto: actividad.querySelector(".texto-actividad")?.textContent || "",
    fecha: actividad.dataset.fecha || "",
    hora: actividad.dataset.hora || "",
    estado: actividad.querySelector(".estado")?.className.split(" ")[1] || "pendiente",
    tecnicos: actividad.dataset.tecnicos || "",
    cliente: actividad.dataset.cliente || "",
    sede: actividad.dataset.sede || "",
    aliado: actividad.dataset.aliado || "",
    observaciones: actividad.dataset.observaciones || ""
  }));

  try {
    localStorage.setItem("actividades", JSON.stringify(actividades));
    renderizarProgramacion();
    renderizarNotificaciones();
    renderizarHistorial();
    aplicarPermisosControles();
  } catch (error) {
    alert("No se pudieron guardar las actividades en este navegador.");
  }
}

function restablecerFormularioActividad() {
  actividadInput.value = "";
  fechaInput.value = "";
  horaInput.value = "";
  estadoEdicionInput.value = "pendiente";
  observacionesActividad.value = "";
  clienteSeleccionado = "";
  sedeSeleccionada = "";
  aliadoSeleccionado = "";
  abrirClientesBtn.textContent = "Selecciona un cliente";
  abrirSedesBtn.textContent = "Selecciona una sede";
  abrirAliadosBtn.textContent = "Selecciona un aliado";
  opcionesTecnicos.querySelectorAll("input").forEach((opcion) => { opcion.checked = false; });
  actualizarTextoSelector();
}

function cancelarEdicion() {
  actividadEnEdicion = null;
  restablecerFormularioActividad();
  agregarBtn.textContent = "➕ Agregar Actividad";
  cancelarEdicionBtn.classList.add("hidden");
  modoEdicionActividad.classList.add("hidden");
  formularioActividad.classList.remove("modal-edicion");
  overlayEdicion.classList.add("hidden");
  overlayEdicion.setAttribute("aria-hidden", "true");
}

function aplicarFiltrosActividades() {
  const busqueda = buscarActividadInput.value.trim().toLowerCase();
  const estadoFiltro = filtroEstadoActividad.value;
  const fechaFiltro = filtroFechaActividad.value;
  let visibles = 0;

  lista.querySelectorAll("li").forEach((actividad) => {
    const contenido = actividad.textContent.toLowerCase();
    const estado = actividad.querySelector(".estado")?.classList[1] || "";
    const coincide = (!busqueda || contenido.includes(busqueda))
      && (estadoFiltro === "todos" || estado === estadoFiltro)
      && (filtroDashboard === "todos" || estado === clasesEstado[filtroDashboard])
      && (!fechaFiltro || actividad.dataset.fecha === fechaFiltro);
    actividad.style.display = coincide ? "flex" : "none";
    if (coincide) visibles++;
  });


  const total = lista.querySelectorAll("li").length;
  contadorActividades.textContent = `${visibles} de ${total} actividad${total === 1 ? "" : "es"}`;
  sinResultadosActividades.classList.toggle("hidden", visibles > 0 || total === 0);
}

function obtenerProgramaciones() {
  try {
    const programaciones = JSON.parse(localStorage.getItem("programaciones"));
    return Array.isArray(programaciones) ? programaciones : [];
  } catch (error) {
    return [];
  }
}

function guardarProgramaciones(programaciones) {
  localStorage.setItem("programaciones", JSON.stringify(programaciones));
  renderizarNotificaciones();
  renderizarHistorial();
}

function mismaProgramacion(primera, segunda) {
  return ["fechaInicio", "fechaFin", "tecnico", "cliente", "sede", "actividad", "observaciones", "estado"]
    .every((campo) => (primera[campo] || "") === (segunda[campo] || ""));
}

function cancelarEdicionProgramacion() {
  programacionEnEdicion = null;
  formularioProgramacion.classList.remove("modal-edicion");
  formularioProgramacion.querySelectorAll("input, select, textarea").forEach((campo) => { campo.disabled = false; });
  overlayEdicion.classList.add("hidden");
  overlayEdicion.setAttribute("aria-hidden", "true");
  fechaInicioProgramacionInput.value = "";
  fechaFinProgramacionInput.value = "";
  tecnicoProgramacionInput.value = "";
  clienteProgramacionInput.value = "";
  sedeProgramacionInput.value = "";
  actividadProgramacionInput.value = "";
  observacionesProgramacionInput.value = "";
  estadoProgramacionInput.value = "programada";
  agregarProgramacionBtn.textContent = "➕ Agregar programación";
  agregarProgramacionBtn.classList.remove("hidden");
  cancelarEdicionProgramacionBtn.classList.add("hidden");
}

function iniciarEdicionProgramacion(programacion) {
  document.querySelector('.menu-item[data-target="programacion"]')?.click();
  actualizarOpcionesProgramacion();
  programacionEnEdicion = programacion;
  const puedeEditar = obtenerPermisosActuales().administrarProgramacion;
  formularioProgramacion.classList.remove("hidden");
  formularioProgramacion.classList.add("modal-edicion");
  overlayEdicion.classList.remove("hidden");
  overlayEdicion.setAttribute("aria-hidden", "false");
  fechaInicioProgramacionInput.value = programacion.fechaInicio || "";
  fechaFinProgramacionInput.value = programacion.fechaFin || "";
  tecnicoProgramacionInput.value = programacion.tecnico || "";
  clienteProgramacionInput.value = programacion.cliente || "";
  sedeProgramacionInput.value = programacion.sede || "";
  actividadProgramacionInput.value = programacion.actividad || "";
  observacionesProgramacionInput.value = programacion.observaciones || "";
  estadoProgramacionInput.value = programacion.estado || "programada";
  agregarProgramacionBtn.textContent = "💾 Guardar programación";
  agregarProgramacionBtn.classList.toggle("hidden", !puedeEditar);
  cancelarEdicionProgramacionBtn.classList.toggle("hidden", !puedeEditar);
  formularioProgramacion.querySelectorAll("input, select, textarea").forEach((campo) => { campo.disabled = !puedeEditar; });
  fechaInicioProgramacionInput.focus();
}

function actualizarOpcionesProgramacion() {
  const catalogos = [
    [tecnicoProgramacionInput, obtenerTecnicos(), "Selecciona un técnico"],
    [clienteProgramacionInput, obtenerClientes(), "Selecciona un cliente"],
    [sedeProgramacionInput, obtenerSedes(), "Selecciona una sede"]
  ];

  catalogos.forEach(([selector, registros, textoVacio]) => {
    const valorActual = selector.value;
    selector.innerHTML = "";
    const opcionVacia = document.createElement("option");
    opcionVacia.value = "";
    opcionVacia.textContent = textoVacio;
    selector.append(opcionVacia);
    registros.filter((registro) => (registro.estado || "activo") === "activo").forEach((registro) => {
      const opcion = document.createElement("option");
      opcion.value = registro.nombre;
      opcion.textContent = registro.nombre;
      selector.append(opcion);
    });
    if ([...selector.options].some((opcion) => opcion.value === valorActual)) selector.value = valorActual;
  });

  const actividadActual = actividadProgramacionInput.value;
  actividadProgramacionInput.innerHTML = "";
  const opcionVacia = document.createElement("option");
  opcionVacia.value = "";
  opcionVacia.textContent = "Selecciona una actividad";
  actividadProgramacionInput.append(opcionVacia);
  obtenerActividades().forEach((actividad) => {
    const opcion = document.createElement("option");
    opcion.value = actividad.texto;
    opcion.textContent = actividad.texto;
    actividadProgramacionInput.append(opcion);
  });
  if ([...actividadProgramacionInput.options].some((opcion) => opcion.value === actividadActual)) {
    actividadProgramacionInput.value = actividadActual;
  }
}

function renderizarProgramacion() {
  const programaciones = obtenerProgramaciones().sort((primera, segunda) =>
    `${primera.fechaInicio}T${primera.fechaFin}`.localeCompare(`${segunda.fechaInicio}T${segunda.fechaFin}`));

  actualizarOpcionesProgramacion();
  listaProgramacion.innerHTML = "";
  contadorProgramacion.textContent = `${programaciones.length} programacion${programaciones.length === 1 ? "" : "es"}`;
  sinProgramacion.classList.toggle("hidden", programaciones.length > 0);

  programaciones.forEach((programacion, indice) => {
    const elemento = document.createElement("li");
    elemento.className = `programacion-${programacion.estado || "programada"}`;
    const contenido = document.createElement("div");
    contenido.className = "contenido-programacion";
    const titulo = document.createElement("strong");
    titulo.textContent = programacion.actividad;
    const informacion = document.createElement("div");
    informacion.className = "informacion-programacion";
    const fecha = document.createElement("span");
    fecha.className = "programacion-fecha";
    fecha.textContent = `📅 ${programacion.fechaInicio} al ${programacion.fechaFin}`;
    const tecnico = document.createElement("span");
    tecnico.className = "programacion-tecnico";
    tecnico.textContent = `👤 ${programacion.tecnico}`;
    const cliente = document.createElement("span");
    cliente.className = "programacion-cliente";
    cliente.textContent = `🏢 ${programacion.cliente}`;
    const sede = document.createElement("span");
    sede.className = "programacion-sede";
    sede.textContent = `📍 ${programacion.sede}`;
    const observaciones = document.createElement("small");
    observaciones.className = "programacion-observaciones";
    observaciones.textContent = `📝 ${programacion.observaciones || "Sin observaciones"}`;
    informacion.append(fecha, tecnico, cliente, sede, observaciones);
    contenido.append(titulo);
    elemento.append(contenido, informacion);
    const acciones = document.createElement("div");
    acciones.className = "acciones-programacion";
    const estado = document.createElement("span");
    estado.className = `estado-programacion ${programacion.estado || "programada"}`;
    estado.textContent = (programacion.estado || "programada").replace("-", " ");
    const editar = document.createElement("button");
    editar.type = "button";
    editar.className = "editar-programacion";
    editar.textContent = "✏️ Editar";
    editar.addEventListener("click", () => iniciarEdicionProgramacion(programacion));
    const eliminar = document.createElement("button");
    eliminar.type = "button";
    eliminar.className = "eliminar-programacion";
    eliminar.textContent = "🗑️";
    eliminar.title = "Eliminar programación";
    eliminar.addEventListener("click", () => {
      const actuales = obtenerProgramaciones();
      const indiceReal = actuales.findIndex((actual) => mismaProgramacion(actual, programacion));
      if (indiceReal >= 0) actuales.splice(indiceReal, 1);
      guardarProgramaciones(actuales);
      renderizarProgramacion();
    });
    acciones.append(estado, editar, eliminar);
    elemento.append(acciones);
    listaProgramacion.append(elemento);
  });

  renderizarResumenProgramacion(programaciones);
  aplicarPermisosControles();
}

function renderizarResumenProgramacion(programaciones = obtenerProgramaciones()) {
  const programadas = programaciones.slice(0, 3);

  dashboardProgramacion.innerHTML = "";
  sinDashboardProgramacion.classList.toggle("hidden", programadas.length > 0);
  programadas.forEach((programacion) => {
    const elemento = document.createElement("li");
    const contenido = document.createElement("div");
    contenido.className = "dashboard-programacion-contenido";
    const titulo = document.createElement("strong");
    titulo.textContent = programacion.actividad;
    const fecha = document.createElement("span");
    fecha.className = "programacion-fecha";
    fecha.textContent = `📅 ${programacion.fechaInicio} al ${programacion.fechaFin}`;
    const tecnico = document.createElement("span");
    tecnico.className = "programacion-tecnico";
    tecnico.textContent = `👤 ${programacion.tecnico}`;
    contenido.append(titulo, fecha, tecnico);

    const informacion = document.createElement("div");
    informacion.className = "dashboard-programacion-informacion";
    const cliente = document.createElement("span");
    cliente.className = "programacion-cliente";
    cliente.textContent = `🏢 ${programacion.cliente}`;
    const sede = document.createElement("span");
    sede.className = "programacion-sede";
    sede.textContent = `📍 ${programacion.sede}`;
    const estado = document.createElement("span");
    estado.className = `estado-programacion ${programacion.estado || "programada"}`;
    estado.textContent = (programacion.estado || "programada").replace("-", " ");
    informacion.append(cliente, sede, estado);
    elemento.append(contenido, informacion);
    dashboardProgramacion.append(elemento);
  });
}

function obtenerConfiguracion() {
  try {
    return JSON.parse(localStorage.getItem("controlDiarioConfiguracion")) || {};
  } catch (error) {
    return {};
  }
}

function cargarConfiguracion() {
  const configuracion = obtenerConfiguracion();
  empresaNombreInput.value = configuracion.empresaNombre || "";
  empresaDocumentoInput.value = configuracion.empresaDocumento || "";
  empresaCorreoInput.value = configuracion.empresaCorreo || "";
  empresaTelefonoInput.value = configuracion.empresaTelefono || "";
  configEstadoInput.value = configuracion.estado || "activo";
  configVistaInput.value = configuracion.vista || "dashboard";


  notificacionesActivadasInput.checked = configuracion.notificaciones !== false;
  recordarFiltrosInput.checked = configuracion.recordarFiltros === true;
}

function renderizarUsuarios() {
  const usuarios = obtenerUsuarios();
  const busqueda = buscarUsuarioInput.value.trim().toLowerCase();
  const permisos = obtenerPermisosActuales();
  listaUsuarios.innerHTML = "";
  Object.entries(usuarios).forEach(([usuario, cuenta]) => {
    const rol = normalizarRol(cuenta.role);
    const etiquetaRol = permisosPorRol[rol].etiqueta;
    const contenidoBusqueda = `${cuenta.name || usuario} ${cuenta.email || ""} ${etiquetaRol}`.toLowerCase();
    if (busqueda && !contenidoBusqueda.includes(busqueda)) return;
    const elemento = document.createElement("li");
    elemento.className = "fila-gestion";
    const datos = document.createElement("div");
    datos.className = "datos-gestion";
    const nombre = document.createElement("strong");
    nombre.textContent = cuenta.name || usuario;
    const detalle = document.createElement("span");
    detalle.textContent = `${cuenta.email || "Sin correo"} · ${etiquetaRol}`;
    datos.append(nombre, detalle);
    const estado = document.createElement("span");
    estado.className = `estado-tecnico ${cuenta.status || "activo"}`;
    estado.textContent = cuenta.status === "inactivo" ? "Inactivo" : "Activo";
    if (permisos.administrarUsuarios) {
      const acciones = document.createElement("div");
      acciones.className = "acciones-gestion";
      const editar = document.createElement("button");
      editar.type = "button";
      editar.textContent = "✏️ Editar";
      editar.addEventListener("click", () => {
        usuarioEnEdicion = usuario;
        usuarioNombreInput.value = cuenta.name || usuario;
        usuarioCorreoInput.value = cuenta.email || "";
        usuarioRolInput.value = rol;
        usuarioEstadoInput.value = cuenta.status || "activo";
        usuarioPasswordInput.value = "";
        guardarUsuarioBtn.textContent = "💾 Guardar cambios";
        modoEdicionUsuario.classList.remove("hidden");
        formularioUsuarios.classList.add("modal-edicion");
        overlayEdicion.classList.remove("hidden");
        overlayEdicion.setAttribute("aria-hidden", "false");
        usuarioNombreInput.focus();
      });
      const eliminar = document.createElement("button");
      eliminar.type = "button";
      eliminar.textContent = "🗑️ Eliminar";
      eliminar.addEventListener("click", () => {
        const actuales = obtenerUsuarios();
        delete actuales[usuario];
        guardarUsuarios(actuales);
        renderizarUsuarios();
      });
      acciones.append(editar, eliminar);
      elemento.append(datos, estado, acciones);
    } else {
      elemento.append(datos, estado);
    }
    listaUsuarios.append(elemento);
  });
}

let usuarioEnEdicion = null;

function actualizarFiltrosReporte() {
  const opciones = [
    [reporteTecnicoInput, obtenerTecnicos(), "Todos los técnicos"],
    [reporteClienteInput, obtenerClientes(), "Todos los clientes"]
  ];
  opciones.forEach(([selector, registros, texto]) => {
    const valorActual = selector.value;
    selector.innerHTML = `<option value="todos">${texto}</option>`;
    registros.forEach((registro) => {
      const opcion = document.createElement("option");
      opcion.value = registro.nombre;
      opcion.textContent = registro.nombre;
      selector.append(opcion);
    });
    selector.value = [...selector.options].some((opcion) => opcion.value === valorActual) ? valorActual : "todos";
  });
}

function crearEstadoVisual(estado) {
  const etiqueta = document.createElement("span");
  const estadoNormalizado = estado || "pendiente";
  etiqueta.className = `estado-texto ${estadoNormalizado}`;
  etiqueta.textContent = estadoNormalizado.replace("-", " ");
  return etiqueta;
}

function renderizarReportes() {
  actualizarFiltrosReporte();
  const desde = reporteFechaInicioInput.value;
  const hasta = reporteFechaFinInput.value;
  const tecnicoFiltro = reporteTecnicoInput.value;
  const clienteFiltro = reporteClienteInput.value;
  const actividades = obtenerActividades().filter((actividad) => {
    const tecnicos = obtenerTecnicosDeActividad(actividad);
    return (!desde || actividad.fecha >= desde)
      && (!hasta || actividad.fecha <= hasta)
      && (tecnicoFiltro === "todos" || tecnicos.includes(tecnicoFiltro))
      && (clienteFiltro === "todos" || actividad.cliente === clienteFiltro);
  });
  const estados = { pendiente: 0, procesando: 0, terminada: 0 };
  actividades.forEach((actividad) => { estados[actividad.estado] = (estados[actividad.estado] || 0) + 1; });
  resumenReporte.innerHTML = "";
  [["Total de actividades", actividades.length, "total"], ["Terminadas", estados.terminada || 0, "terminadas"], ["Pendientes", estados.pendiente || 0, "pendientes"], ["En proceso", estados.procesando || 0, "proceso"]].forEach(([titulo, valor, clase]) => {
    const tarjeta = document.createElement("div");
    tarjeta.className = `resumen-reporte-item resumen-reporte-${clase}`;
    const etiqueta = document.createElement("span");
    etiqueta.textContent = titulo;
    const cantidad = document.createElement("strong");
    cantidad.textContent = valor;
    tarjeta.append(etiqueta, cantidad);
    resumenReporte.append(tarjeta);
  });
  listaReporte.innerHTML = "";
  sinResultadosReporte.classList.toggle("hidden", actividades.length > 0);
  actividades.forEach((actividad) => {
    const fila = document.createElement("tr");
    [
      actividad.fecha || "Sin fecha",
      actividad.texto || "Sin actividad",
      obtenerTecnicosDeActividad(actividad).join(", ") || "Sin técnico",
      actividad.cliente || "Sin cliente"
    ].forEach((valor) => {
      const celda = document.createElement("td");
      celda.textContent = valor;
      fila.append(celda);
    });
    const celdaEstado = document.createElement("td");
    celdaEstado.append(crearEstadoVisual(actividad.estado));
    fila.append(celdaEstado);
    listaReporte.append(fila);
  });
}

function obtenerActividadesFiltradasReporte() {
  const desde = reporteFechaInicioInput.value;
  const hasta = reporteFechaFinInput.value;
  const tecnicoFiltro = reporteTecnicoInput.value;
  const clienteFiltro = reporteClienteInput.value;
  return obtenerActividades().filter((actividad) => {
    const tecnicos = obtenerTecnicosDeActividad(actividad);
    return (!desde || actividad.fecha >= desde)
      && (!hasta || actividad.fecha <= hasta)
      && (tecnicoFiltro === "todos" || tecnicos.includes(tecnicoFiltro))
      && (clienteFiltro === "todos" || actividad.cliente === clienteFiltro);
  });
}

function exportarReporteCsv() {
  const actividades = obtenerActividadesFiltradasReporte();
  const tecnicos = obtenerTecnicos();
  const clientes = obtenerClientes();

  const escapar = (valor) => `"${String(valor || "").replace(/"/g, '""')}"`;

  const filas = [];

  filas.push(["DATOS DE TÉCNICOS"]);
  filas.push(["Nombre", "Documento", "Teléfono", "Correo", "Estado"]);

  tecnicos.forEach((tecnico) => {
    filas.push([
      tecnico.nombre || "",
      tecnico.documento || "",
      tecnico.telefono || "",
      tecnico.correo || "",
      tecnico.estado || "activo"
    ]);
  });

  filas.push([]);
  filas.push(["DATOS DE CLIENTES"]);
  filas.push(["Nombre", "Documento", "Teléfono", "Correo", "Estado"]);

  clientes.forEach((cliente) => {
    filas.push([
      cliente.nombre || "",
      cliente.documento || "",
      cliente.telefono || "",
      cliente.correo || "",
      cliente.estado || "activo"
    ]);
  });

  filas.push([]);
  filas.push(["REPORTE DE ACTIVIDADES"]);
  filas.push(["Fecha", "Actividad", "Técnico(s)", "Cliente", "Estado"]);

  actividades.forEach((actividad) => {
    filas.push([
      actividad.fecha || "Sin fecha",
      actividad.texto || "Sin actividad",
      obtenerTecnicosDeActividad(actividad).join(", ") || "Sin técnico",
      actividad.cliente || "Sin cliente",
      (actividad.estado || "pendiente").replace("-", " ")
    ]);
  });

  const contenido = filas
    .map((fila) => fila.map(escapar).join(";"))
    .join("\n");

  const enlace = document.createElement("a");
  enlace.href = URL.createObjectURL(
    new Blob([`\ufeff${contenido}`], {
      type: "text/csv;charset=utf-8;"
    })
  );

  enlace.download = `reporte-actividades-${new Date().toISOString().slice(0, 10)}.csv`;
  enlace.click();
  URL.revokeObjectURL(enlace.href);
}

function renderizarNotificaciones() {
  if (obtenerConfiguracion().notificaciones === false) {
    listaNotificaciones.innerHTML = "";
    contadorNotificaciones.textContent = "0";
    contadorNotificaciones.classList.add("hidden");
    sinNotificaciones.textContent = "Las notificaciones están desactivadas en Configuración.";
    sinNotificaciones.classList.remove("hidden");
    return;
  }
  sinNotificaciones.textContent = "No hay notificaciones.";
  const notificaciones = [];
  const hoy = new Date();
  const formatearFechaClave = (fecha) => `${fecha.getFullYear()}-${String(fecha.getMonth() + 1).padStart(2, "0")}-${String(fecha.getDate()).padStart(2, "0")}`;
  const fechaHoy = formatearFechaClave(hoy);
  const manana = new Date(hoy);
  manana.setDate(manana.getDate() + 1);
  const fechaManana = formatearFechaClave(manana);

  obtenerActividades().forEach((actividad) => {
    const nombre = actividad.texto || "Actividad sin nombre";
    if (actividad.fecha && actividad.fecha >= fechaHoy && actividad.fecha <= fechaManana) {
      notificaciones.push({
        tipo: "proxima",
        icono: "⏰",
        destino: "actividades",
        texto: `Se acerca la actividad: ${nombre} (${actividad.fecha}${actividad.hora ? `, ${formatearHora(actividad.hora)}` : ""})`
      });
    }
    if (actividad.estado !== "terminada") {
      notificaciones.push({ tipo: "pendiente", icono: "⏳", destino: "actividades", texto: `Actividad no terminada: ${nombre}` });
    } else {
      notificaciones.push({ tipo: "terminada", icono: "✅", destino: "actividades", texto: `Actividad terminada: ${nombre}` });
    }
  });
  obtenerProgramaciones().forEach((programacion) => {
    notificaciones.push({
      tipo: "programacion",
      icono: "📅",
      destino: "programacion",
      texto: `Programación encontrada: ${programacion.actividad} (${programacion.fechaInicio})`
    });
  });
  listaNotificaciones.innerHTML = "";
  contadorNotificaciones.textContent = String(notificaciones.length);
  contadorNotificaciones.classList.remove("hidden");
  sinNotificaciones.classList.toggle("hidden", notificaciones.length > 0);
  notificaciones.forEach((notificacion) => {
    const fila = document.createElement("li");
    fila.className = `notificacion-${notificacion.tipo}`;
    fila.tabIndex = 0;
    fila.setAttribute("role", "button");
    const icono = document.createElement("span");
    icono.className = "notificacion-icono";
    icono.textContent = notificacion.icono;
    const texto = document.createElement("span");
    texto.textContent = notificacion.texto;
    fila.append(icono, texto);
    const abrirModulo = () => document.querySelector(`.menu-item[data-target="${notificacion.destino}"]`)?.click();
    fila.addEventListener("click", abrirModulo);
    fila.addEventListener("keydown", (evento) => {
      if (evento.key === "Enter" || evento.key === " ") {
        evento.preventDefault();
        abrirModulo();
      }
    });
    listaNotificaciones.append(fila);
  });
}

function renderizarHistorial() {
  actualizarFiltrosHistorial();
  const fechaFiltro = historialFechaInput.value;
  const tecnicoFiltro = historialTecnicoInput.value;
  const clienteFiltro = historialClienteInput.value;
  const estadoFiltro = historialEstadoInput.value;
  listaHistorial.innerHTML = "";
  const programaciones = obtenerProgramaciones();
  const actividades = obtenerActividades().filter((actividad) => {
    const tecnicos = obtenerTecnicosDeActividad(actividad);
    const estado = obtenerEstadoHistorial(actividad, programaciones);
    return (!fechaFiltro || actividad.fecha === fechaFiltro)
      && (tecnicoFiltro === "todos" || tecnicos.includes(tecnicoFiltro))
      && (clienteFiltro === "todos" || actividad.cliente === clienteFiltro)
      && (estadoFiltro === "todos" || estado.clave === estadoFiltro);
  });
  sinResultadosHistorial.classList.toggle("hidden", actividades.length > 0);
  actividades.forEach((actividad) => {
    const estado = obtenerEstadoHistorial(actividad, programaciones);
    const fila = document.createElement("tr");
    [
      actividad.fecha || "Sin fecha",
      actividad.texto || "Sin actividad",
      obtenerTecnicosDeActividad(actividad).join(", ") || "Sin técnico",
      actividad.cliente || "Sin cliente"
    ].forEach((valor) => {
      const celda = document.createElement("td");
      celda.textContent = valor;
      fila.append(celda);
    });
    const celdaEstado = document.createElement("td");
    const etiquetaEstado = document.createElement("span");
    etiquetaEstado.className = `estado-texto historial-estado ${estado.clave}`;
    etiquetaEstado.textContent = estado.etiqueta;
    celdaEstado.append(etiquetaEstado);
    fila.append(celdaEstado);
    const celdaAccion = document.createElement("td");
    const accion = document.createElement("button");
    accion.type = "button";
    accion.className = `accion-historial accion-historial-${estado.clave === "programada" ? "programacion" : "actividad"}`;
    accion.textContent = estado.clave === "programada" ? "Ver programación" : "Ver actividad";
    accion.addEventListener("click", () => {
      if (estado.clave === "programada") {
        const programacion = programaciones.find((registro) => registro.actividad === actividad.texto);
        if (programacion) iniciarEdicionProgramacion(programacion);
        return;
      }
      if (!obtenerPermisosActuales().administrarActividades) {
        document.querySelector('.menu-item[data-target="actividades"]')?.click();
        return;
      }
      document.querySelector('.menu-item[data-target="actividades"]')?.click();
      const elementoActividad = [...lista.querySelectorAll("li")].find((elemento) =>
        elemento.querySelector(".texto-actividad")?.textContent === actividad.texto
        && elemento.dataset.fecha === actividad.fecha
        && elemento.dataset.hora === actividad.hora
      );
      if (elementoActividad) iniciarEdicion(elementoActividad);
    });
    celdaAccion.append(accion);
    fila.append(celdaAccion);
    listaHistorial.append(fila);
  });
}

function obtenerEstadoHistorial(actividad, programaciones = obtenerProgramaciones()) {
  if (actividad.estado === "terminada") return { clave: "terminada", etiqueta: "Terminada" };
  if (actividad.estado === "procesando") return { clave: "procesando", etiqueta: "En proceso" };
  if (programaciones.some((programacion) => programacion.actividad === actividad.texto)) {
    return { clave: "programada", etiqueta: "Programada" };
  }
  return { clave: "creada", etiqueta: "Actividad creada" };
}

function actualizarFiltrosHistorial() {
  [[historialTecnicoInput, obtenerTecnicos(), "Todos los técnicos"], [historialClienteInput, obtenerClientes(), "Todos los clientes"]].forEach(([selector, registros, texto]) => {
    const valorActual = selector.value;
    selector.innerHTML = `<option value="todos">${texto}</option>`;
    registros.forEach((registro) => {
      const opcion = document.createElement("option");
      opcion.value = registro.nombre;
      opcion.textContent = registro.nombre;
      selector.append(opcion);
    });
  
    selector.value = [...selector.options].some((opcion) => opcion.value === valorActual) ? valorActual : "todos";
  });
}
 

function obtenerTecnicos() {
  try {
    const tecnicos = JSON.parse(localStorage.getItem("tecnicos"));
    return Array.isArray(tecnicos) ? tecnicos : [];
  } catch (error){
    return [];
    
  }
}



function guardarTecnicos() {
  const tecnicos = [...listaTecnicos.querySelectorAll("li")].map((tecnico) => ({
    nombre: tecnico.dataset.nombre || tecnico.querySelector(".nombre-tecnico")?.textContent || "",
    documento: tecnico.dataset.documento || "",
    telefono: tecnico.dataset.telefono || "",
    correo: tecnico.dataset.correo || "",
    estado: tecnico.dataset.estado || "activo"
  }));

  localStorage.setItem("tecnicos", JSON.stringify(tecnicos));
}



function obtenerClientes() {
  try {
    const clientes = JSON.parse(localStorage.getItem("clientes"));
    return Array.isArray(clientes) ? clientes : [];
  } catch (error) {
    return [];
  }
}

function guardarClientes() {
  const clientes = [...listaClientes.querySelectorAll("li")].map((cliente) => ({
    nombre: cliente.dataset.nombre || cliente.querySelector(".nombre-cliente")?.textContent || "",
    documento: cliente.dataset.documento || "",
    telefono: cliente.dataset.telefono || "",
    correo: cliente.dataset.correo || "",
    estado: cliente.dataset.estado || "activo"
    
  }));
  localStorage.setItem("clientes", JSON.stringify(clientes));
}


function obtenerSedes() {

  try {
    const sedes = JSON.parse(localStorage.getItem("sedes"));
    return Array.isArray(sedes) ? sedes : [];
  } catch (error) {
    return [];
  }
}

function guardarSedes() {
  const sedes = [...listaSedes.querySelectorAll("li")].map((sede) => ({
    nombre: sede.dataset.nombre || sede.querySelector(".nombre-sede")?.textContent || "",
    cliente: sede.dataset.cliente || "",
    direccion: sede.dataset.direccion || "",
    ciudad: sede.dataset.ciudad || "",
    estado: sede.dataset.estado || "activo"
  }));
  localStorage.setItem("sedes", JSON.stringify(sedes));
}

