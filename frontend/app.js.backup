function crearCliente(datosCliente) {
  const cliente = typeof datosCliente === "string"
    ? { nombre: datosCliente, documento: "", telefono: "", correo: "", estado: "activo" }
    : { estado: "activo", ...datosCliente };
  const nuevoCliente = document.createElement("li");
  const nombre = document.createElement("span");
  nombre.className = "nombre-cliente";
  nombre.textContent = cliente.nombre;

  const datos = document.createElement("div");
  datos.className = "datos-cliente";
  [
    `NIT/documento: ${cliente.documento || "Sin registrar"}`,
    `Tel: ${cliente.telefono || "Sin registrar"}`,
    cliente.correo || "Sin correo"
  ].forEach((dato) => {
    const datoTexto = document.createElement("span");
    datoTexto.textContent = dato;
    datos.append(datoTexto);
  });


  const estado = document.createElement("span");
  estado.className = `estado-tecnico ${cliente.estado}`;
  estado.textContent = cliente.estado === "activo" ? "Activo" : "Inactivo";

  nuevoCliente.dataset.nombre = cliente.nombre;
  nuevoCliente.dataset.documento = cliente.documento;
  nuevoCliente.dataset.telefono = cliente.telefono;
  nuevoCliente.dataset.correo = cliente.correo;
  nuevoCliente.dataset.estado = cliente.estado;

  const eliminarBtn = document.createElement("button");
  eliminarBtn.className = "eliminar-cliente";
  eliminarBtn.type = "button";
  eliminarBtn.textContent = "🗑️ Eliminar";
  eliminarBtn.title = "Eliminar cliente";

  nuevoCliente.append(nombre, datos, estado, eliminarBtn);
  listaClientes.append(nuevoCliente);
  actualizarOpcionesClientes();
  actualizarClientesDeSede();

  eliminarBtn.addEventListener("click", () => {
    nuevoCliente.remove();
    actualizarOpcionesClientes();
    actualizarClientesDeSede();
    guardarClientes();
  });
}
function actualizarClientesDeSede() {
  const clienteActual = clienteSedeInput.value;
  clienteSedeInput.innerHTML = "";
  const opcionVacia = document.createElement("option");
  opcionVacia.value = "";
  opcionVacia.textContent = "Selecciona un cliente";
  clienteSedeInput.append(opcionVacia);

  obtenerClientes().forEach((cliente) => {
    if ((cliente.estado || "activo") !== "activo") return;
    const opcion = document.createElement("option");
    opcion.value = cliente.nombre;
    opcion.textContent = cliente.nombre;
    clienteSedeInput.append(opcion);
  });

  if ([...clienteSedeInput.options].some((opcion) => opcion.value === clienteActual)) {
    clienteSedeInput.value = clienteActual;
  }
}

