document.querySelectorAll(".menu-item").forEach((boton) => {
  boton.addEventListener("click", () => {
    const target = boton.dataset.target;
    if (!target) return;
    if (!obtenerPermisosActuales().modulos.includes(target)) return;

    document.querySelectorAll(".menu-item").forEach((item) => {
      item.classList.toggle("active", item === boton);
    });
    document.querySelectorAll(".module-panel").forEach((panel) => {
      panel.classList.toggle("active", panel.dataset.modulePanel === target);
    });
    if (target === "programacion") renderizarProgramacion();
    if (target === "configuracion") cargarConfiguracion();
    if (target === "usuarios") renderizarUsuarios();
    if (target === "reportes") renderizarReportes();
    if (target === "notificaciones") renderizarNotificaciones();
    if (target === "historial") renderizarHistorial();
  });
  });

