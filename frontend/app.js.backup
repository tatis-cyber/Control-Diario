   //CAMBIOS EN USUARIOS Y PERMISOS

  
const ROLES_CONTROL_DIARIO = {
  administrador: {
    nombre: "Administrador",
    permisos: [
      "dashboard",
      "actividades",
      "programacion",
      "tecnicos",
      "clientes",
      "sedes",
      "aliados",
      "notificaciones",
      "reportes",
      "historial",
      "usuarios",
      "configuracion"
    ]
  },

  coordinador: {
    nombre: "Coordinador",
    permisos: [
      "dashboard",
      "actividades",
      "programacion",
      "tecnicos",
      "clientes",
      "sedes",
      "aliados",
      "notificaciones",
      "reportes",
      "historial"
    ]
  },

  tecnico: {
    nombre: "Técnico",
    permisos: [
      "dashboard",
      "actividades",
      "programacion",
      "notificaciones",
      "historial"
    ]
  },

  consulta: {
    nombre: "Consulta",
    permisos: [
      "dashboard",
      "notificaciones",
      "reportes",
      "historial"
    ]
  }
};

function obtenerRolUsuarioActual() {
  return localStorage.getItem("rolUsuarioActual") || "administrador";
}

function establecerRolUsuarioActual(rol) {
  if (!ROLES_CONTROL_DIARIO[rol]) {
    console.warn("Rol no válido:", rol);
    return false;
  }

  localStorage.setItem("rolUsuarioActual", rol);
  return true;
}

function usuarioTienePermiso(modulo) {
  const rol = obtenerRolUsuarioActual();
  const configuracion = ROLES_CONTROL_DIARIO[rol];

  if (!configuracion) return false;

  return configuracion.permisos.includes(modulo);
}

function obtenerNombreRolActual() {
  const rol = obtenerRolUsuarioActual();
  return ROLES_CONTROL_DIARIO[rol]?.nombre || "Administrador";
}


